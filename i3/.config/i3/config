client.placeholder      #1f1a14  #1f1a14  #7a6e5c  #1f1a14   #1f1a14
client.background       #1f1a14

# ---------- Lock screen ----------
bindsym $mod+Shift+x exec --no-startup-id ~/.config/i3/lock.sh
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.config/i3/lock.sh
exec --no-startup-id xset s 600 5
bindsym $mod+Shift+e exec --no-startup-id ~/.config/i3/powermenu.sh
bindsym $mod+F1 exec --no-startup-id ~/.config/i3/keys.sh

# ---------- App launchers ----------
bindsym $mod+Shift+f exec --no-startup-id thunar
bindsym $mod+Shift+b exec --no-startup-id brave-browser
bindsym $mod+Shift+s exec --no-startup-id steam
exec_always --no-startup-id xrdb -merge ~/.Xresources


# ---------- Screenshots ----------
bindsym F4 exec --no-startup-id sh -c 'maim -s | xclip -selection clipboard -t image/png'
bindsym $mod+F4 exec --no-startup-id sh -c 'maim | xclip -selection clipboard -t image/png'
bindsym Shift+F4 exec --no-startup-id sh -c 'mkdir -p ~/Pictures/Screenshots && maim -s ~/Pictures/Screenshots/$(date +%F_%H-%M-%S).png'

# ---------- Workspace rules ----------
assign [class="steam"] workspace number 3

# ---------- systemd user session (needed for portals) ----------
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP=i3
exec --no-startup-id systemctl --user import-environment DISPLAY XAUTHORITY
exec --no-startup-id systemctl --user start i3-session.target
