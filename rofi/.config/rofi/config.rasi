configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Adwaita";
    font:                "JetBrains Mono 11";
    display-drun:        "Apps";
    display-run:         "Run";
    display-window:      "Windows";
    drun-display-format: "{name}";
}

